# Copy to .env and export these in your environment. Never commit real values.

# Claude extraction for uploaded sources. Without a key, uploads use keyword rules. The demo needs no key.
ANTHROPIC_API_KEY=
BATON_EXTRACT_MODEL=claude-haiku-5-5

# Force an extractor: claude, ollama or rules. Leave empty to choose automatically.
BATON_EXTRACTOR=
BATON_OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# Signs the session cookie. Set this in any deployment, or restarts will sign everyone out.
BATON_SECRET=
# Set to 1 when served over HTTPS.
BATON_HTTPS_ONLY=0

# Storage. The default is SQLite under BATON_DATA_DIR.
BATON_DATA_DIR=data
BATON_DATABASE_URL=

# Load the checking models at startup (1) or on the first run (0).
BATON_PRELOAD=1
