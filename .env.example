# Copy to .env and fill in what you have. .env is ignored by git. Never paste these values into chat.

# --- Hosted extraction: Groq. Without a key, uploads use keyword rules. The demo needs no key.
GROQ_API_KEY=
# Any model Groq lists at https://console.groq.com/docs/models
BATON_EXTRACT_MODEL=openai/gpt-oss-120b

# --- Supabase: database and sign-in. Steps are in docs/DEPLOY.md; check with: python deploy/check_supabase.py
# Dashboard, Connect, Session pooler (not Direct). Without this, data stays in local SQLite.
BATON_DATABASE_URL=
SUPABASE_URL=
# The publishable key (sb_publishable_...) or legacy anon key. Never the secret or service_role key.
SUPABASE_ANON_KEY=

# --- Hugging Face: a token with write access, and the Space to create, as owner/name.
HF_TOKEN=
HF_SPACE=

# --- GitHub: a token that can push, and an existing repository, as owner/name.
GITHUB_TOKEN=
GITHUB_REPO=

# --- Optional
# Signs the session cookie. Set it in any deployment, or restarts sign everyone out.
BATON_SECRET=
# 1 when served over HTTPS.
BATON_HTTPS_ONLY=0
BATON_DATA_DIR=data
# Force an extractor: groq, claude, ollama or rules. Empty chooses automatically.
BATON_EXTRACTOR=
BATON_OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434
ANTHROPIC_API_KEY=
# Load the checking models at startup (1) or on the first run (0).
BATON_PRELOAD=1
